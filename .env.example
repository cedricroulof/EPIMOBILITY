# Copier en .env (jamais commité) pour surcharger les valeurs par défaut de docker-compose.yml.
# development : cookies non Secure, mot de passe de démo par défaut. production : cookies Secure, HSTS, DEMO_PASSWORD obligatoire.
APP_ENV=development
# Mot de passe des comptes de démo : admin@exemple.test, etudiant1@exemple.test … etudiant3@exemple.test
DEMO_PASSWORD=demo1234
POSTGRES_PASSWORD=epimobility
# Hors Docker (uvicorn lancé à la main), l'API lit DATABASE_URL ; défaut : SQLite ./epimobility.db
# DATABASE_URL=postgresql+psycopg://epimobility:epimobility@localhost:5432/epimobility
