# Copy to .env (never committed) to override the default values of docker-compose.yml.
# development: non-Secure cookies, default demo password. production: Secure cookies, HSTS, DEMO_PASSWORD required.
APP_ENV=development
# Password of the demo accounts: admin@exemple.test, etudiant1@exemple.test … etudiant3@exemple.test
DEMO_PASSWORD=demo1234
POSTGRES_PASSWORD=epimobility
# Outside Docker (uvicorn started by hand), the API reads DATABASE_URL; default: SQLite ./epimobility.db
# DATABASE_URL=postgresql+psycopg://epimobility:epimobility@localhost:5432/epimobility
